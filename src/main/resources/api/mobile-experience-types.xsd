<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://standardbank.ao/mobilebanking/experience/1.0"
            xmlns:tns="http://standardbank.ao/mobilebanking/experience/1.0"
            xmlns:common="http://standardbank.ao/common/types/1.0"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            elementFormDefault="qualified">

    <!-- Este arquivo também precisa importar o common-types.xsd,
         porque usa common:AccountSummary, common:RiskFlag, etc. -->
    <xsd:import namespace="http://standardbank.ao/common/types/1.0"
                schemaLocation="common-types.xsd"/>

    <!-- ===================== viewDashboard ===================== -->
    <xsd:element name="viewDashboardRequest">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="customerId" type="xsd:long"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="viewDashboardResponse">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="accounts" type="common:AccountSummary" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element name="aggregateBalance" type="xsd:decimal"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <!-- ===================== makeTransfer ===================== -->
    <xsd:element name="makeTransferRequest">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="sourceAccountId" type="xsd:long"/>
                <xsd:element name="destinationAccountId" type="xsd:long"/>
                <xsd:element name="amount" type="xsd:decimal"/>
                <xsd:element name="description" type="xsd:string" minOccurs="0"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="makeTransferResponse">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="status" type="xsd:string"/>
                <xsd:element name="message" type="xsd:string"/>
                <xsd:element name="newBalance" type="xsd:decimal"/>
                <xsd:element name="riskFlag" type="common:RiskFlag"/>
                <xsd:element name="alertMessage" type="xsd:string" minOccurs="0"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <!-- ===================== viewStatement ===================== -->
    <xsd:element name="viewStatementRequest">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="accountId" type="xsd:long"/>
                <xsd:element name="startDate" type="xsd:date"/>
                <xsd:element name="endDate" type="xsd:date"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="viewStatementResponse">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="accountId" type="xsd:long"/>
                <xsd:element name="iban" type="xsd:string"/>
                <xsd:element name="transactions" type="common:StatementTransaction" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <!-- ===================== viewSpendingInsights ===================== -->
    <xsd:element name="viewSpendingInsightsRequest">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="customerId" type="xsd:long"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="viewSpendingInsightsResponse">
        <xsd:complexType>
            <xsd:sequence>
            	<xsd:element name="title" type="xsd:string"/>
            	<xsd:element name="description" type="xsd:string"/>
                <xsd:element name="insights" type="common:InsightCard" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <!-- ===================== blockOrUnblockCard ===================== -->
    <xsd:element name="blockOrUnblockCardRequest">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="cardId" type="xsd:long"/>
                <xsd:element name="action" type="common:CardAction"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="blockOrUnblockCardResponse">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="cardId" type="xsd:long"/>
                <xsd:element name="status" type="xsd:string"/>
                <xsd:element name="message" type="xsd:string"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>
